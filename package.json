{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "vite build",
    "build:client": "tsc -p tsconfig.client.json --noEmit && node scripts/with-env.mjs APP_TARGET=client -- vite build --mode production --outDir dist/client",
    "build:demo": "tsc -p tsconfig.demo.json --noEmit && node scripts/with-env.mjs APP_TARGET=demo -- vite build --mode demo --outDir dist/demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:access-path": "node scripts/gen-access-path.mjs",
    "gen:dataset": "node scripts/write-dataset.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wreq-js": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
