{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@dietrichgebert/ponytail", "opencode-supermemory", "oh-my-opencode"],
  "permissions": [
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -f*", "effect": "deny" },
    { "action": "shell", "resource": "git rebase*", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch*", "effect": "deny" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git add*", "effect": "ask" },
    { "action": "shell", "resource": "git merge*", "effect": "ask" }
  ]
}
