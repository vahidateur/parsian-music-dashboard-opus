# Data source: "demo" (localStorage DemoStore, default) or "api" (real REST backend)
VITE_DATA_SOURCE=demo

# Base URL of the /api/v1 REST backend. Used only when VITE_DATA_SOURCE=api.
VITE_API_BASE_URL=/api/v1

# ---------------------------------------------------------------------------
# Secret access path (private deployment)
#
# When set, the panel renders ONLY at https://<host>/<VITE_ACCESS_PATH>/ (or
# ?k=<value>). Any other URL returns a bare "404 Not Found" body with no
# branding, so scanners record nothing.
#
# Generate one with:   npm run gen:access-path
#
# This is OBSCURITY, NOT SECURITY. A URL leaks through history, Referer
# headers, bookmark sync and screenshots. It removes opportunistic scanners; it
# is never a substitute for authentication. Leave empty to disable the gate.
#
# Must be 24-128 chars of [A-Za-z0-9_-]; a shorter value is rejected at startup.
VITE_ACCESS_PATH=

# Optional: pin the API to an absolute origin. Leave as a relative path so the
# browser never talks to a different host than the one serving the panel.
